# Supabase (서버 전용 — NEXT_PUBLIC_ 접두사 사용 금지)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 세션 쿠키 서명 키 (openssl rand -base64 32)
SESSION_SECRET=

# Vercel Cron 인증 헤더
CRON_SECRET=

# 관리자 초기 계정 (최초 1회 시딩용. 시딩 후 삭제)
ADMIN_LOGIN_ID=
ADMIN_INIT_PASSWORD=

# 애플리케이션 기준 시간대
TZ=Asia/Seoul
